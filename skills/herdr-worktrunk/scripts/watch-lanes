#!/usr/bin/env bash
# Watch this supervisor's lanes in herdr; print the lanes that need a
# reaction and exit. Usage:
#   bash scripts/watch-lanes          # poll until any NAMED lane hits a trigger state
#   bash scripts/watch-lanes --all    # include unnamed panes (other agents in the session)
#   bash scripts/watch-lanes --list   # snapshot lanes + statuses once, then exit
#   bash scripts/watch-lanes --all --list  # snapshot every lane, named or not
#   bash scripts/watch-lanes --except <id> [--except <id>]...
#                                     # skip lanes you're already handling: a done
#                                     # lane stays done until torn down, and would
#                                     # otherwise wake every re-armed watcher at once
#
# Triggers: blocked (approval/question dialog), idle, done — idle/done both
# mean ready for input. working and unknown never fire (unknown covers
# detached/sleeping agents). Only lanes started with `herdr agent start
# <name>` carry a name, so named-only watching keeps other panes in the
# session from waking the supervisor.
# Output: one tab-separated line per triggering lane — <id> <pane-id> <status>.
# With --all an unnamed lane's id is its pane id; both forms are accepted by
# every herdr agent command.
# Env: WATCH_INTERVAL_S — poll interval in seconds, default 20.

set -u

die() { echo "watch-lanes: $*" >&2; exit 2; }

[[ "${HERDR_ENV:-}" == "1" ]] || die "not inside Herdr (HERDR_ENV != 1); refusing to run"
command -v jq >/dev/null 2>&1 || die "jq not found in PATH"
command -v herdr >/dev/null 2>&1 || die "herdr not found in PATH"

INTERVAL="${WATCH_INTERVAL_S:-20}"
[[ "$INTERVAL" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "WATCH_INTERVAL_S must be numeric, got: $INTERVAL"

LIST=0 ALL=0 EXCEPT='[]'
while [[ $# -gt 0 ]]; do
  case "$1" in
    --all)    ALL=1 ;;
    --list)   LIST=1 ;;
    --except) [[ $# -ge 2 ]] || die "--except needs a lane id"
              EXCEPT=$(jq -c --arg id "$2" '. + [$id]' <<<"$EXCEPT"); shift ;;
    *)        die "unknown argument: $1" ;;
  esac
  shift
done

if [[ $ALL -eq 1 ]]; then
  SCOPE=''
  LABEL='lanes'
else
  SCOPE='select((.name // "") != "") | '
  LABEL='named lanes'
fi
# shellcheck disable=SC2016 # $id and $except are jq variables
TRIG='select(.agent_status=="blocked" or .agent_status=="idle" or .agent_status=="done") | select((.name // .pane_id) as $id | $except | index($id) | not)'
ROW='[(.name // .pane_id), .pane_id, .agent_status] | @tsv'

if [[ $LIST -eq 1 ]]; then
  json=$(herdr agent list 2>/dev/null) || { echo 'watch-lanes: herdr agent list failed' >&2; exit 1; }
  lines=$(printf '%s' "$json" | jq -r ".result.agents[] | ${SCOPE}${ROW}") || die "cannot parse herdr agent list output"
  total=$(printf '%s' "$json" | jq -r '.result.agents | length') || die "cannot parse herdr agent list output"
  shown=$(printf '%s\n' "$lines" | sed '/^$/d' | wc -l | tr -d ' ')
  printf '%s\n' "$lines" | sed '/^$/d'
  echo "# $shown $LABEL of $total total"
  exit 0
fi

while :; do
  json=$(herdr agent list 2>/dev/null); rc=$?
  if [[ $rc -ne 0 ]]; then
    echo "watch-lanes: herdr agent list failed (rc=$rc); retrying" >&2
  else
    hit=$(printf '%s' "$json" | jq -r --argjson except "$EXCEPT" ".result.agents[] | ${SCOPE}${TRIG} | ${ROW}" 2>/dev/null)
    if [[ -n "$hit" ]]; then
      printf '%s\n' "$hit"
      exit 0
    fi
  fi
  sleep "$INTERVAL"
done
